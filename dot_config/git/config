[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[user]
  name = Eve Jensen
  email = evesjensen@gmail.com

[init]
  defaultBranch = main

[color]
  ui = auto

[core]
  excludesfile = ~/.config/git/ignore
  editor = nvim

[merge]
  tool = nvimdiff
  conflictstyle = diff3

[mergetool "nvimdiff"]
  layout = LOCAL,MERGED,REMOTE + (LOCAL,BASE,REMOTE)/MERGED

[diff]
  tool = nvimdiff
  colorMoved = default
  wsErrorHighlight = all

[commit]
  verbose = true

[rerere]
  enabled = true
  autoUpdate = true

[push]
  useForceIfIncludes = true

[alias]
  a = add
  b = branch
  c = commit
  ca = commit -a
  cam = commit -am
  d = diff
  ds = diff --staged
  dt = difftool
  dts = difftool --staged
  f = fetch
  ff = merge --ff-only
  l = log
  lf = log --pretty=fuller
  ll = pull
  lg = log --graph --pretty=format:'%C(yellow)%h%Creset%C(bold red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lga = log --graph --pretty=format:'%C(yellow)%h%Creset%C(bold red)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --all
  lo = log --pretty=oneline
  m = merge
  p = push
  pf = push --force-with-lease
  r = remote
  rb = rebase
  rst = reset
  s = status
  sh = show
  shn = show --name-status
  sw = switch
  wt = worktree
